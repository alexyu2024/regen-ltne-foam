FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

porousDrag
{
    type            explicitPorositySource;

    explicitPorositySourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        porous;

        type            DarcyForchheimer;

        d   (3.375e9 3.375e9 3.375e9);  // Ergun viscous: 150 (1-eps)^2 / (eps^3 d_p^2), 1/m2
        f   (65625 65625 65625);        // Ergun inertial: C2 = 2 x 1.75 (1-eps) / (eps^3 d_p), 1/m

        coordinateSystem
        {
            origin  (0 0 0);
            e1      (1 0 0);
            e3      (0 0 1);
        }
    }
}
