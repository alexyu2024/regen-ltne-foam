/*--------------------------------*- C++ -*----------------------------------*\
  regen-ltne-foam, OpenFOAM v2512
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     ltneFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         150;
deltaT          5e-3;
writeControl    runTime;
writeInterval   150;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
adjustTimeStep  no;

DebugSwitches
{
    SolverPerformance   0;
}

functions
{
    outletT
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            outlet;
        operation       areaAverage;
        fields          (T);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   20;
    }
}
