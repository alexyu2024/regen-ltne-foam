# L5P inputs of the LRG run, pinned by commit on the L5P branch (pss/driver-natural-ref).
# Filled in when the L5P reference passes L5P.3 under Amendment A2 (docs/VERIFICATION.md, LRG).
L5P_ACCEPT_SHA=     # commit with the accepted reference: pss/, results/L5P/natural/{per_cycle,cycles}.csv, reference json
L5P_REF_JSON=       # path of the accepted reference json in that commit
L5P_RESTART_SHA=    # commit holding results/L5P/natural/restart/state.tgz at cycle N_R
N_R=                # latest L5P restart point strictly before N_REF
N_REF=              # accepted reference cycle
