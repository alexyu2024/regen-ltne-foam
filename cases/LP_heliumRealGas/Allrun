#!/bin/sh
# LP: evaluate the real-gas helium thermo at the NIST points (docs/VERIFICATION.md, LP).
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

../../src/Allwmake > log.build 2>&1 \
 && echo "realGasPropsCheck binary: $(command -v realGasPropsCheck)" >> log.build

cp ../../src/ltneRealGas/tables/helium_CoolProp.dat constant/
restore0Dir
runApplication blockMesh
runApplication realGasPropsCheck

# LP.17/18: each point just outside the table must stop the run (exit status recorded in the log)
for d in oorLowT oorHighT oorLowP oorHighP
do
    realGasPropsCheck -dict system/$d > log.$d 2>&1
    echo "exit status: $?" >> log.$d
done
