#!/bin/sh
# Two LTNE relaxation runs (docs/VERIFICATION.md, L3): r (c_s = 500) and b (c_s = 5).
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

../../src/Allwmake > log.build 2>&1 \
 && echo "ltneFoam binary: $(command -v ltneFoam)" >> log.build

for run in r b
do
    rm -rf run_$run
    mkdir run_$run
    cp -r 0.orig constant system run_$run/
done
foamDictionary run_b/constant/ltneProperties -entry CpS -set 5 > /dev/null
foamDictionary run_b/system/controlDict -entry deltaT -set 1.8e-6 > /dev/null
foamDictionary run_b/system/controlDict -entry endTime -set 0.0009 > /dev/null

for run in r b
do
    (
        cd run_$run || exit 1
        restore0Dir
        runApplication blockMesh
        runApplication ltneFoam
    )
done
