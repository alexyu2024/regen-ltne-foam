#!/bin/bash
# L5 base run from the initial state: Allrun [cycles] (default 40).
# Continue a run with Allrun.continue <cycles>; the full driver is runLong.sh.
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions
cycles=${1:-40}

../../src/Allwmake > log.build 2>&1 \
 && echo "ltneFoam binary: $(command -v ltneFoam)" >> log.build

python3 mkCase.py . > log.mkCase 2>&1 || exit 1
restore0Dir
runApplication blockMesh
runApplication topoSet
sed -i "s/^endTime .*/endTime         $(python3 -c "print(repr($cycles/23.0))");/" system/controlDict
./Allrun.continue 0
