FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

porousDrag
{
    type            explicitPorositySource;

    explicitPorositySourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        porous;

        type            DarcyForchheimer;

        d   (1e9 1e9 1e9);      // 1/alpha, 1/m2
        f   (1e5 1e5 1e5);      // C2, 1/m

        coordinateSystem
        {
            origin  (0 0 0);
            e1      (1 0 0);
            e3      (0 0 1);
        }
    }
}
