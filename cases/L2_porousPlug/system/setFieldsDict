FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues ();

regions
(
    zoneToCell
    {
        zone porous;
        fieldValues
        (
            volScalarFieldValue porosity 0.7
        );
    }
);
