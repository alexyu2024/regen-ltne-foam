#!/bin/sh
# Four steady-flow runs through the Darcy-Forchheimer plug (docs/VERIFICATION.md, L2),
# differing only in the inlet velocity.
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

../../src/Allwmake > log.build 2>&1 \
 && echo "ltneFoam binary: $(command -v ltneFoam)" >> log.build

for run in v1:0.001 v2:0.01 v3:0.1 v4:1
do
    name=${run%%:*}
    u=${run##*:}
    rm -rf run_$name
    mkdir run_$name
    cp -r 0.orig constant system run_$name/
    foamDictionary run_$name/0.orig/U -entry boundaryField/inlet/value \
        -set "uniform ($u 0 0)" > /dev/null
    (
        cd run_$name || exit 1
        restore0Dir
        runApplication blockMesh
        runApplication setFields
        runApplication ltneFoam
    )
done
