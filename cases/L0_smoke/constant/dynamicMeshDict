FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Piston at x = 0; the cells between x = 0 and x = 0.04 (start of the porous
// plug) stretch linearly, the rest of the mesh does not move.
dynamicFvMesh    dynamicMotionSolverFvMesh;
motionSolverLibs (ltnePistonMotion);
motionSolver     pistonLinear;

axis    (1 0 0);

pistons
{
    piston
    {
        piston      0;
        fixed       0.04;
        displacement
        {
            type        sine;
            amplitude   1e-3;       // m
            scale       1;
            level       0;
            frequency   50;         // Hz
        }
    }
}
