FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      ltneProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solid matrix (stainless-steel screen, round numbers) and film coefficient
active  true;
rhoS    7900;       // kg/m3
CpS     500;        // J/kg/K
kS      15;         // W/m/K (intrinsic; multiplied by 1 - porosity)
hsf     1000;       // W/m2/K
